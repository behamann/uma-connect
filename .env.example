# Copy to .env.local and fill with the LOCAL stack values from `npx supabase status`.
# Never put production values in .env.local: `next dev`, builds and tests must only hit the local stack.
# Leave both empty to build the guest-only site (account features hidden).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: GitHub Pages project path, e.g. /uma-connect (empty for local dev).
NEXT_PUBLIC_BASE_PATH=

# Production values:
# - NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / NEXT_PUBLIC_BASE_PATH live only
#   as GitHub repository variables used by the Pages deploy workflow.
# - SUPABASE_URL and SUPABASE_SECRET_KEY (sb_secret_...) live only in .env.production.secret and are read by
#   `npm run backend:sync-puzzles:prod`. Never prefix the secret key with NEXT_PUBLIC_.
